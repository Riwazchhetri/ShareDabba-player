rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBookmark(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.streamUrl is string && data.streamUrl.size() >= 1 && data.streamUrl.size() <= 500 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(bookmarkId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(bookmarkId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'streamUrl', 'category', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'streamUrl', 'category', 'createdAt', 'updatedAt']) &&
                       isValidBookmark(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(bookmarkId) &&
                       request.auth.uid == userId &&
                       isValidBookmark(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'streamUrl', 'category', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(bookmarkId) &&
                       request.auth.uid == userId;
    }
  }
}
